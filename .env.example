DISCORD_TOKEN=
DISCORD_GUILD_ID=
DATABASE_PATH=./data/gork.db
# RSS module: the jev service (docker-compose sets this to http://jev:8017). Unset: the module is off.
JEV_URL=
# Chat + ruling summaries: the local model (docker-compose sets http://llm:8019). Unset: chat is off, rulings post without summaries.
LLM_URL=
# Chat web search: SearXNG (docker-compose sets http://search:8080). Unset: chat answers without searching.
SEARCH_URL=
